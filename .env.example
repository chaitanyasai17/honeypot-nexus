EVENTBUS_WORKERS=1
HEALTH_SAMPLE_SECONDS=5
EVENT_RETENTION_DAYS=30
HONEYPOT_RESPONSE_JITTER_MS=0-0

# --- Demo ---
DEMO_MODE=true
